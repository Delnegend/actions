{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Delnegend/actions/main/scripts/README.schema.json",
  "title": "Delnegend README.yml Schema",
  "description": "Standardized schema for auto-generating README.md and LICENSE files across Delnegend projects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "repo",
    "tagline",
    "badges",
    "quick_start",
    "highlights",
    "documentation",
    "license"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL to this JSON Schema file"
    },
    "name": {
      "type": "string",
      "description": "Project title or name (e.g. Differ, dpi-proxy)"
    },
    "repo": {
      "type": "string",
      "description": "GitHub repository in owner/repo format (e.g. Delnegend/differ)"
    },
    "tagline": {
      "type": "string",
      "description": "One-line bold project description beneath the title"
    },
    "badges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ci",
        "release",
        "license"
      ],
      "description": "Configuration for badges displayed in header",
      "properties": {
        "ci": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "workflow": {
                  "type": "string"
                },
                "branch": {
                  "type": "string"
                }
              }
            }
          ],
          "description": "Enable CI badge (default: true) or specify workflow and branch"
        },
        "release": {
          "type": "boolean",
          "description": "Enable GitHub release badge (default: true)"
        },
        "license": {
          "type": "boolean",
          "description": "Enable license badge (default: true)"
        },
        "custom": {
          "type": "array",
          "description": "Optional list of additional custom badges",
          "items": {
            "type": "object",
            "required": [
              "image",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "quick_start": {
      "type": "string",
      "description": "Quick Start section markdown content (commands, install steps, docker compose)"
    },
    "highlights": {
      "type": "array",
      "minItems": 1,
      "description": "List of key features, each rendered as a bullet point",
      "items": {
        "type": "string"
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "development",
        "deployment"
      ],
      "description": "Required documentation links: architecture, development, and deployment (including configuration).",
      "properties": {
        "architecture": {
          "oneOf": [
            {
              "type": "string",
              "description": "Description of architecture documentation (path defaults to docs/architecture.md)"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "development": {
          "oneOf": [
            {
              "type": "string",
              "description": "Description of development documentation (path defaults to docs/development.md)"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "deployment": {
          "oneOf": [
            {
              "type": "string",
              "description": "Description of deployment and configuration documentation (path defaults to docs/deployment.md)"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "oneOf": [
            {
              "type": "boolean",
              "const": false,
              "description": "Set to false for unlicensed or private projects"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "description": "List of supported licenses: 'MIT' and/or 'APACHE-2.0'",
              "items": {
                "type": "string",
                "enum": [
                  "MIT",
                  "APACHE-2.0"
                ]
              }
            }
          ]
        },
        "holder": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Copyright holder(s), default: Delnegend"
        },
        "text": {
          "type": "string",
          "description": "Custom license paragraph in README.md overriding standard text"
        },
        "note": {
          "type": "string",
          "description": "Extra notice appended to license text in README.md"
        },
        "filename": {
          "type": "string",
          "description": "Filename for single license (e.g. LICENSE or LICENSE-MIT)"
        }
      }
    }
  }
}
